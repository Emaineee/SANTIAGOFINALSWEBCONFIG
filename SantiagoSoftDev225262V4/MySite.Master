<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="MySite.Master.cs" Inherits="SantiagoSoftDev225262V4.MySite" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SoftDev System</title>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@300;400;500;600;700;800&family=Quicksand:wght@500;600;700&display=swap" rel="stylesheet">
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
<style>
/* ═══════════════════════════════════════════════════════════
   CSS VARIABLES — Light Blue Feminine Theme
═══════════════════════════════════════════════════════════ */
:root {
    --sky-50:    #f0f9ff;
    --sky-100:   #e0f2fe;
    --sky-200:   #bae6fd;
    --sky-300:   #7dd3fc;
    --sky-400:   #38bdf8;
    --sky-500:   #0ea5e9;
    --sky-600:   #0284c7;
    --sky-700:   #0369a1;

    --blush:     #fce7f3;
    --blush-d:   #fbcfe8;
    --rose:      #f43f5e;
    --rose-s:    #fb7185;

    --lavender:  #ede9fe;
    --violet:    #8b5cf6;

    --mint:      #d1fae5;
    --emerald:   #10b981;

    --white:     #ffffff;
    --bg:        #f0f8ff;
    --bg-card:   #ffffff;
    --border:    #bae6fd;
    --border-s:  #e0f2fe;

    --text-dark:  #0c4a6e;
    --text-mid:   #0369a1;
    --text-muted: #7fb7d4;
    --text-body:  #334155;

    --sidebar-w:  250px;
    --radius-lg:  20px;
    --radius-md:  14px;
    --radius-sm:  10px;
    --shadow:     0 4px 24px rgba(14,165,233,0.10);
    --shadow-md:  0 8px 32px rgba(14,165,233,0.16);
    --transition: .22s cubic-bezier(.4,0,.2,1);
}

/* ═══════════════════════════════════════════════════════════
   RESET
═══════════════════════════════════════════════════════════ */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html, body { height: 100%; }

body {
    font-family: 'Nunito', sans-serif;
    background: var(--bg);
    color: var(--text-body);
    min-height: 100vh;
    overflow-x: hidden;
    /* Soft dot pattern background */
    background-image:
        radial-gradient(circle, rgba(14,165,233,0.07) 1px, transparent 1px);
    background-size: 28px 28px;
    background-attachment: fixed;
}

/* ═══════════════════════════════════════════════════════════
   APP SHELL
═══════════════════════════════════════════════════════════ */
.app-shell { display: flex; min-height: 100vh; }

/* ═══════════════════════════════════════════════════════════
   SIDEBAR
═══════════════════════════════════════════════════════════ */
.sidebar {
    width: var(--sidebar-w);
    background: linear-gradient(180deg, #e0f2fe 0%, #f0f9ff 60%, #fce7f3 100%);
    border-right: 2px solid var(--border);
    display: flex;
    flex-direction: column;
    position: fixed;
    top: 0; left: 0;
    height: 100vh;
    z-index: 100;
    transition: transform var(--transition);
    overflow-y: auto;
    box-shadow: 4px 0 24px rgba(14,165,233,0.08);
}

/* Brand area */
.sidebar-brand {
    padding: 28px 20px 22px;
    border-bottom: 2px solid var(--border-s);
    text-align: center;
}

.brand-mark {
    width: 56px; height: 56px;
    background: linear-gradient(135deg, var(--sky-400) 0%, var(--sky-600) 100%);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    margin: 0 auto 10px;
    box-shadow: 0 4px 16px rgba(56,189,248,0.4);
    border: 3px solid white;
}

.brand-name {
    font-family: 'Quicksand', sans-serif;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-dark);
    line-height: 1.2;
}

.brand-sub {
    font-size: .68rem;
    color: var(--text-muted);
    letter-spacing: .5px;
    margin-top: 3px;
    font-weight: 500;
}

/* Sparkle decoration */
.sparkles {
    display: flex;
    justify-content: center;
    gap: 4px;
    margin-top: 6px;
    font-size: 10px;
}

/* Nav sections */
.nav-section { padding: 14px 14px 6px; }

.nav-label {
    font-size: .62rem;
    font-weight: 800;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: var(--sky-400);
    padding: 0 8px;
    margin-bottom: 6px;
    font-family: 'Quicksand', sans-serif;
}

.nav-link {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 11px 12px;
    border-radius: var(--radius-sm);
    color: var(--text-mid);
    text-decoration: none;
    font-size: .875rem;
    font-weight: 600;
    transition: background var(--transition), color var(--transition), transform var(--transition);
    margin-bottom: 3px;
    cursor: pointer;
    border: none;
    background: none;
    width: 100%;
    text-align: left;
    font-family: 'Nunito', sans-serif;
    position: relative;
    overflow: hidden;
}

.nav-link::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(56,189,248,0.12), transparent);
    opacity: 0;
    transition: opacity var(--transition);
    border-radius: var(--radius-sm);
}

.nav-link:hover { color: var(--sky-700); transform: translateX(3px); }
.nav-link:hover::before { opacity: 1; }

.nav-link.active {
    background: linear-gradient(90deg, rgba(56,189,248,0.18), rgba(56,189,248,0.06));
    color: var(--sky-700);
    border: 1.5px solid var(--border);
}

.nav-icon {
    width: 20px; height: 20px;
    text-align: center;
    font-size: 15px;
    flex-shrink: 0;
}

/* Sidebar footer */
.sidebar-footer {
    margin-top: auto;
    padding: 16px 14px;
    border-top: 2px solid var(--border-s);
}

/* User session - clickable */
.user-session {
    position: relative;
}

.user-pill {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px;
    border-radius: var(--radius-md);
    background: white;
    border: 1.5px solid var(--border);
    margin-bottom: 10px;
    box-shadow: var(--shadow);
    cursor: pointer;
    transition: border-color var(--transition), box-shadow var(--transition);
}

.user-pill:hover {
    border-color: var(--sky-400);
    box-shadow: var(--shadow-md);
}

.user-pill .session-arrow {
    margin-left: auto;
    font-size: 10px;
    color: var(--text-muted);
    transition: transform var(--transition);
    flex-shrink: 0;
}

.user-pill.open .session-arrow {
    transform: rotate(180deg);
}

.user-avatar {
    width: 36px; height: 36px;
    background: linear-gradient(135deg, var(--blush-d) 0%, var(--sky-200) 100%);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    flex-shrink: 0;
    border: 2px solid white;
    box-shadow: 0 2px 8px rgba(14,165,233,0.2);
}

.user-info { flex: 1; min-width: 0; }

.user-name {
    font-size: .82rem;
    font-weight: 700;
    color: var(--text-dark);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.user-role {
    font-size: .66rem;
    color: var(--text-muted);
    font-weight: 500;
}

/* Session dropdown */
.session-dropdown {
    display: none;
    background: white;
    border: 1.5px solid var(--border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    overflow: hidden;
    animation: slideDown .2s cubic-bezier(.22,1,.36,1) both;
    margin-bottom: 10px;
}

.session-dropdown.open { display: block; }

@keyframes slideDown {
    from { opacity: 0; transform: translateY(-6px); }
    to   { opacity: 1; transform: translateY(0); }
}

.session-timer {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    background: var(--sky-50);
    border-bottom: 1.5px solid var(--border-s);
    font-size: .76rem;
    color: var(--text-muted);
    font-weight: 600;
}

.session-timer .timer-icon {
    font-size: 14px;
    animation: pulse 1.5s ease-in-out infinite;
}

@keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: .4; }
}

@keyframes popIn {
    from { opacity: 0; transform: scale(0.9); }
    to   { opacity: 1; transform: scale(1); }
}

.timer-countdown {
    font-family: 'Courier New', monospace;
    font-weight: 800;
    color: var(--sky-600);
    font-size: .82rem;
    margin-left: auto;
}

.session-actions {
    padding: 6px;
}

.session-action-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    padding: 9px 12px;
    border-radius: var(--radius-sm);
    border: none;
    background: none;
    font-family: 'Nunito', sans-serif;
    font-size: .82rem;
    font-weight: 600;
    color: var(--text-dark);
    cursor: pointer;
    transition: background var(--transition);
    text-decoration: none;
}

.session-action-btn:hover {
    background: var(--sky-50);
    text-decoration: none;
}

.session-action-btn.danger {
    color: var(--rose);
}

.session-action-btn.danger:hover {
    background: #fff1f2;
}

.session-action-icon {
    width: 18px;
    text-align: center;
    font-size: 14px;
    flex-shrink: 0;
}

.logout-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    padding: 10px 14px;
    border-radius: var(--radius-sm);
    background: #fff1f2;
    border: 1.5px solid #fecdd3;
    color: #e11d48;
    font-size: .855rem;
    font-weight: 700;
    cursor: pointer;
    transition: background var(--transition), transform var(--transition);
    font-family: 'Nunito', sans-serif;
    text-decoration: none;
}

.logout-btn:hover {
    background: #ffe4e6;
    transform: translateX(2px);
    text-decoration: none;
}

.guest-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    padding: 10px 14px;
    border-radius: var(--radius-sm);
    background: #eff6ff;
    border: 1.5px solid var(--border);
    color: var(--sky-700);
    font-size: .855rem;
    font-weight: 700;
    cursor: pointer;
    transition: background var(--transition), transform var(--transition);
    font-family: 'Nunito', sans-serif;
    text-decoration: none;
}

.guest-btn:hover { background: var(--sky-100); transform: translateX(2px); text-decoration: none; }

/* ═══════════════════════════════════════════════════════════
   MAIN CONTENT
═══════════════════════════════════════════════════════════ */
.main-content {
    margin-left: var(--sidebar-w);
    flex: 1;
    min-height: 100vh;
}

/* Top Bar */
.topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 28px;
    border-bottom: 2px solid var(--border-s);
    background: rgba(255,255,255,0.85);
    backdrop-filter: blur(12px);
    position: sticky;
    top: 0;
    z-index: 50;
    box-shadow: 0 2px 12px rgba(14,165,233,0.07);
}

.topbar-left { display: flex; flex-direction: column; }

.topbar-title {
    font-family: 'Quicksand', sans-serif;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-dark);
    letter-spacing: -.2px;
}

.topbar-breadcrumb {
    font-size: .72rem;
    color: var(--text-muted);
    margin-top: 1px;
    font-weight: 500;
}

.topbar-right {
    display: flex;
    align-items: center;
    gap: 10px;
}

.topbar-badge {
    padding: 5px 14px;
    background: var(--sky-100);
    border: 1.5px solid var(--border);
    border-radius: 999px;
    font-size: .72rem;
    font-weight: 700;
    color: var(--sky-700);
    font-family: 'Quicksand', sans-serif;
    letter-spacing: .3px;
}

.hamburger {
    display: none;
    background: var(--sky-100);
    border: 1.5px solid var(--border);
    color: var(--sky-700);
    font-size: 18px;
    cursor: pointer;
    padding: 6px 10px;
    border-radius: var(--radius-sm);
    font-weight: 700;
}

/* Page Body */
.page-body {
    padding: 28px 32px;
    width: 100%;
}

/* ═══════════════════════════════════════════════════════════
   SIDEBAR OVERLAY (MOBILE)
═══════════════════════════════════════════════════════════ */
.sidebar-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(12,74,110,0.3);
    backdrop-filter: blur(2px);
    z-index: 99;
}

/* ═══════════════════════════════════════════════════════════
   RESPONSIVE
═══════════════════════════════════════════════════════════ */
@media (max-width: 768px) {
    .sidebar { transform: translateX(-100%); }
    .sidebar.open { transform: translateX(0); }
    .sidebar-overlay.open { display: block; }
    .main-content { margin-left: 0; }
    .hamburger { display: block; }
    .page-body { padding: 20px 16px; }
    .topbar { padding: 12px 16px; }
    .topbar-badge { display: none; }
}

/* ═══════════════════════════════════════════════════════════
   SHARED COMPONENT STYLES (used across pages)
═══════════════════════════════════════════════════════════ */

/* Cards */
.card-base {
    background: white;
    border: 2px solid var(--border-s);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    padding: 28px;
    margin-bottom: 24px;
}

/* Page header */
.page-header {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 28px;
}

.page-header-icon {
    width: 48px; height: 48px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    background: var(--sky-100);
    border: 2px solid var(--border);
    flex-shrink: 0;
}

.page-header-text h1 {
    font-family: 'Quicksand', sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-dark);
    margin-bottom: 3px;
}

.page-header-text p {
    font-size: .83rem;
    color: var(--text-muted);
    font-weight: 500;
}

/* Buttons (global) */
.btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 10px 20px;
    border-radius: var(--radius-sm);
    font-family: 'Nunito', sans-serif;
    font-size: .875rem;
    font-weight: 700;
    cursor: pointer;
    border: none;
    text-decoration: none;
    transition: transform var(--transition), box-shadow var(--transition), opacity var(--transition);
    letter-spacing: .1px;
}

.btn:hover { transform: translateY(-2px); opacity: .92; }
.btn:active { transform: translateY(0); }

.btn-primary {
    background: linear-gradient(135deg, var(--sky-400) 0%, var(--sky-600) 100%);
    color: white;
    box-shadow: 0 4px 16px rgba(56,189,248,0.35);
}

.btn-primary:hover { box-shadow: 0 6px 24px rgba(56,189,248,0.5); }

.btn-success {
    background: linear-gradient(135deg, #34d399 0%, #10b981 100%);
    color: white;
    box-shadow: 0 4px 14px rgba(16,185,129,0.3);
}

.btn-warning {
    background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
    color: white;
    box-shadow: 0 4px 14px rgba(245,158,11,0.3);
}

.btn-danger {
    background: linear-gradient(135deg, #fb7185 0%, #e11d48 100%);
    color: white;
    box-shadow: 0 4px 14px rgba(225,29,72,0.28);
}

.btn-ghost {
    background: white;
    color: var(--text-mid);
    border: 1.5px solid var(--border);
}

.btn-ghost:hover { background: var(--sky-50); }

/* Tables */
.table-wrap { overflow-x: auto; border-radius: var(--radius-md); }

.data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: .875rem;
}

.data-table th {
    background: linear-gradient(90deg, var(--sky-100) 0%, var(--sky-50) 100%);
    color: var(--text-dark);
    padding: 14px 16px;
    text-align: left;
    font-family: 'Quicksand', sans-serif;
    font-weight: 700;
    font-size: .8rem;
    letter-spacing: .4px;
    border-bottom: 2px solid var(--border);
    white-space: nowrap;
}

.data-table td {
    padding: 13px 16px;
    border-bottom: 1px solid var(--border-s);
    color: var(--text-body);
    font-weight: 500;
}

.data-table tr:hover td { background: var(--sky-50); }
.data-table tr:last-child td { border-bottom: none; }

/* Form inputs */
.form-group { margin-bottom: 18px; }

.form-label {
    display: block;
    font-size: .78rem;
    font-weight: 700;
    color: var(--text-dark);
    letter-spacing: .5px;
    text-transform: uppercase;
    margin-bottom: 7px;
    font-family: 'Quicksand', sans-serif;
}

.form-input {
    width: 100%;
    padding: 12px 16px;
    background: var(--sky-50);
    border: 2px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text-dark);
    font-family: 'Nunito', sans-serif;
    font-size: .925rem;
    font-weight: 500;
    outline: none;
    transition: border-color var(--transition), box-shadow var(--transition), background var(--transition);
}

.form-input::placeholder { color: var(--text-muted); }

.form-input:focus {
    border-color: var(--sky-400);
    background: white;
    box-shadow: 0 0 0 3px rgba(56,189,248,0.15);
}

/* Badges */
.badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px 10px;
    border-radius: 999px;
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .3px;
    font-family: 'Quicksand', sans-serif;
}

.badge-blue { background: var(--sky-100); color: var(--sky-700); border: 1px solid var(--border); }
.badge-green { background: var(--mint); color: #065f46; border: 1px solid #a7f3d0; }
.badge-rose { background: var(--blush); color: #9f1239; border: 1px solid var(--blush-d); }

/* Message labels */
.msg-error { color: var(--rose); font-size: .83rem; font-weight: 600; display: block; margin-top: 8px; }
.msg-success { color: var(--emerald); font-size: .83rem; font-weight: 600; display: block; margin-top: 8px; }
</style>
</head>

<body>
    <form id="form1" runat="server">

        <div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>

        <div class="app-shell">

            <!-- ══════════════════════════════════════════════
                 SIDEBAR
            ══════════════════════════════════════════════ -->
            <nav class="sidebar" id="sidebar">
                <div class="sidebar-brand">
                    <div class="brand-mark"></div>
                    <div class="brand-name">SoftDev MS</div>
                    <div class="brand-sub">Student Information System</div>
                    <div class="sparkles"></div>
                </div>

                <!-- Public links -->
                <div class="nav-section">
                    <div class="nav-label">Navigation</div>
                    <a href="~/Landingpage.aspx" runat="server" class="nav-link">
                        <span class="nav-icon"> </span> Home
                    </a>
                    <a href="~/Login.aspx" runat="server" class="nav-link">
                        <span class="nav-icon"></span> Login / Register
                    </a>
                </div>

                <!-- Secured links -->
                <asp:Panel ID="pnlSecuredNav" runat="server">
                    <div class="nav-section">
                        <div class="nav-label">Management</div>
                        <a href="~/Dashboard.aspx" runat="server" class="nav-link">
                            <span class="nav-icon"></span> Dashboard
                        </a>
                        <a href="~/CollegeCrud.aspx" runat="server" class="nav-link">
                            <span class="nav-icon"></span> Colleges
                        </a>
                        <a href="~/ProgramCrud.aspx" runat="server" class="nav-link">
                            <span class="nav-icon"></span> Programs
                        </a>
                        <a href="~/StudentInfoCrud.aspx" runat="server" class="nav-link">
                            <span class="nav-icon"> </span> Students
                        </a>
                    </div>
                </asp:Panel>

                <!-- Footer -->
                <div class="sidebar-footer">
                    <asp:Panel ID="pnlUserInfo" runat="server">
                        <div class="user-session">
                            <div class="user-pill" id="sessionPill" onclick="toggleSessionDropdown()">
                                <div class="user-avatar"></div>
                                <div class="user-info">
                                    <div class="user-name">
                                        <asp:Literal ID="litUsername" runat="server" />
                                    </div>
                                    <div class="user-role">Authenticated User</div>
                                </div>
                                <span class="session-arrow">▾</span>
                            </div>
                            <div class="session-dropdown" id="sessionDropdown">
                                <div class="session-timer">
                                    <span class="timer-icon">⏱</span>
                                    <span>Session expires in:</span>
                                    <span class="timer-countdown" id="timerDisplay">30:00</span>
                                </div>
                                <div class="session-actions">
                                    <asp:LinkButton ID="lbtnStayActive" runat="server"
                                        CssClass="session-action-btn"
                                        OnClientClick="stayLoggedIn(); return false;">
                                        <span class="session-action-icon">🔄</span>
                                        Stay Active
                                    </asp:LinkButton>
                                    <asp:LinkButton ID="lbtnLogout" runat="server"
                                        CssClass="session-action-btn danger"
                                        OnClick="lbtnLogout_Click">
                                        <span class="session-action-icon">🚪</span>
                                        Sign Out
                                    </asp:LinkButton>
                                </div>
                            </div>
                        </div>
                    </asp:Panel>
                    <asp:Panel ID="pnlGuest" runat="server" Visible="false">
                        <a href="~/Login.aspx" runat="server" class="guest-btn">
                             Sign In
                        </a>
                    </asp:Panel>
                </div>
            </nav>

            <!-- ══════════════════════════════════════════════
                 MAIN AREA
            ══════════════════════════════════════════════ -->
            <div class="main-content">

                <!-- Top Bar -->
                <div class="topbar">
                    <div class="topbar-left">
                        <div class="topbar-title">
                            <asp:ContentPlaceHolder ID="PageTitle" runat="server">
                                Dashboard
                            </asp:ContentPlaceHolder>
                        </div>
                        <div class="topbar-breadcrumb">
                            <asp:ContentPlaceHolder ID="PageBreadcrumb" runat="server">
                                SoftDev System
                            </asp:ContentPlaceHolder>
                        </div>
                    </div>
                    <div class="topbar-right">
                        <div class="topbar-badge"> SoftDev v4</div>
                        <button type="button" class="hamburger" onclick="toggleSidebar()">☰</button>
                    </div>
                </div>

                <!-- Page Content -->
                <div class="page-body">
                    <asp:ContentPlaceHolder ID="MainContent" runat="server" />
                </div>

            </div>
        </div>

    </form>

<script>
function toggleSidebar() {
    document.getElementById('sidebar').classList.toggle('open');
    document.getElementById('sidebarOverlay').classList.toggle('open');
}

function toggleSessionDropdown() {
    var pill = document.getElementById('sessionPill');
    var dropdown = document.getElementById('sessionDropdown');
    pill.classList.toggle('open');
    dropdown.classList.toggle('open');
}

// Close dropdown when clicking outside
document.addEventListener('click', function(e) {
    var session = document.querySelector('.user-session');
    if (session && !session.contains(e.target)) {
        var pill = document.getElementById('sessionPill');
        var dropdown = document.getElementById('sessionDropdown');
        if (pill) pill.classList.remove('open');
        if (dropdown) dropdown.classList.remove('open');
    }
});

// Highlight active nav link
(function() {
    var path = window.location.pathname.toLowerCase();
    var links = document.querySelectorAll('.nav-link');
    links.forEach(function(link) {
        var href = (link.getAttribute('href') || '').toLowerCase();
        if (href && path.includes(href.replace('~/', '').replace('.aspx', ''))) {
            link.classList.add('active');
        }
    });
})();

// ================= INACTIVITY TIMEOUT WITH 10s WARNING =================
(function() {
    var timeoutSeconds = 30;
    var warningSeconds = 10;
    var timer = null;
    var countdownTimer = null;
    var warningTimer = null;
    var warningCountdown = null;
    var warned = false;
    var remaining = timeoutSeconds;
    var warningRemaining = warningSeconds;

    function resetTimer() {
        warned = false;
        remaining = timeoutSeconds;
        warningRemaining = warningSeconds;
        clearTimeout(timer);
        clearInterval(countdownTimer);
        clearTimeout(warningTimer);
        clearInterval(warningCountdown);
        hideModal();
        updateSidebarDisplay();
        timer = setTimeout(showWarning, timeoutSeconds * 1000);
        countdownTimer = setInterval(sidebarTick, 1000);
    }

    function sidebarTick() {
        remaining--;
        if (remaining <= 0) remaining = 0;
        updateSidebarDisplay();
    }

    function warningTick() {
        warningRemaining--;
        if (warningRemaining <= 0) {
            clearInterval(warningCountdown);
            doLogout();
        }
        updateModalDisplay();
    }

    function updateSidebarDisplay() {
        var display = document.getElementById('timerDisplay');
        if (display) {
            var mins = Math.floor(remaining / 60);
            var secs = remaining % 60;
            display.textContent = (mins < 10 ? '0' : '') + mins + ':' + (secs < 10 ? '0' : '') + secs;
            display.style.color = remaining <= 10 ? '#e11d48' : '';
        }
    }

    function updateModalDisplay() {
        var display = document.getElementById('modalTimer');
        if (display) {
            display.textContent = warningRemaining + 's';
            if (warningRemaining <= 3) {
                display.style.color = '#e11d48';
            } else {
                display.style.color = '#0284c7';
            }
        }
    }

    function showWarning() {
        if (warned) return;
        warned = true;
        var modal = document.getElementById('inactivityModal');
        if (modal) modal.style.display = 'flex';
        warningRemaining = warningSeconds;
        updateModalDisplay();
        warningCountdown = setInterval(warningTick, 1000);
    }

    function hideModal() {
        var modal = document.getElementById('inactivityModal');
        if (modal) modal.style.display = 'none';
    }

    function doLogout() {
        window.location.href = 'Logout.aspx';
    }

    var events = ['mousedown', 'mousemove', 'keypress', 'scroll', 'touchstart', 'click'];
    events.forEach(function(evt) {
        document.addEventListener(evt, resetTimer, true);
    });

    resetTimer();

    window.stayLoggedIn = resetTimer;
    window.confirmLogout = doLogout;
})();
</script>

<!-- Inactivity Confirmation Modal -->
<div id="inactivityModal" style="display:none; position:fixed; inset:0; background:rgba(12,74,110,0.45); backdrop-filter:blur(4px); z-index:9999; align-items:center; justify-content:center; font-family:'Nunito',sans-serif;">
    <div style="background:white; border-radius:22px; padding:36px 32px 28px; max-width:380px; width:90%; text-align:center; box-shadow:0 16px 48px rgba(14,165,233,0.2); border:2px solid #bae6fd; animation:popIn .35s cubic-bezier(.22,1,.36,1) both;">
        <div style="width:56px; height:56px; background:linear-gradient(135deg,#fee2e2,#fecdd3); border-radius:50%; margin:0 auto 16px; display:flex; align-items:center; justify-content:center; font-size:24px; border:3px solid white; box-shadow:0 4px 16px rgba(225,29,72,0.15);">⏱</div>
        <h3 style="font-family:'Quicksand',sans-serif; font-size:1.2rem; font-weight:700; color:#0c4a6e; margin-bottom:6px;">Session Expiring</h3>
        <p style="font-size:.875rem; color:#7fb7d4; margin-bottom:6px; font-weight:500;">You've been inactive. Auto-logout in:</p>
        <div style="font-family:'Courier New',monospace; font-size:2.2rem; font-weight:800; color:#0284c7; margin-bottom:24px; transition:color .3s;" id="modalTimer">10s</div>
        <div style="display:flex; gap:10px; justify-content:center;">
            <button type="button" onclick="window.confirmLogout()" style="padding:10px 24px; border-radius:10px; border:2px solid #fecdd3; background:#fff1f2; color:#e11d48; font-size:.875rem; font-weight:700; cursor:pointer; font-family:'Nunito',sans-serif; transition:all .2s; flex:1;">Logout</button>
            <button type="button" onclick="window.stayLoggedIn()" style="padding:10px 24px; border-radius:10px; border:none; background:linear-gradient(135deg,#38bdf8,#0284c7); color:white; font-size:.875rem; font-weight:700; cursor:pointer; font-family:'Nunito',sans-serif; transition:all .2s; box-shadow:0 4px 14px rgba(56,189,248,0.35); flex:1;">Stay Logged In</button>
        </div>
    </div>
</div>

</body>
</html>
